<?xml version="1.0" encoding="UTF-8"?>
<fo:root xmlns:fo="http://www.w3.org/1999/XSL/Format">
  <fo:layout-master-set>
    <fo:simple-page-master master-name="page-with-header-footer"
                          page-width="210mm"
                          page-height="297mm"
                          margin="20mm">
      <fo:region-body margin-top="15mm" margin-bottom="15mm"/>
      <fo:region-before extent="10mm"/>
      <fo:region-after extent="10mm"/>
    </fo:simple-page-master>
  </fo:layout-master-set>

  <fo:page-sequence master-reference="page-with-header-footer">
    <fo:static-content flow-name="xsl-region-before">
      <fo:block text-align="center" font-size="10pt" border-bottom="1pt solid black" padding-bottom="3pt">
        Document Header
      </fo:block>
    </fo:static-content>

    <fo:static-content flow-name="xsl-region-after">
      <fo:block text-align="center" font-size="9pt" border-top="1pt solid black" padding-top="3pt">
        Document Footer
      </fo:block>
    </fo:static-content>

    <fo:flow flow-name="xsl-region-body">
      <fo:block font-size="16pt" font-weight="bold" space-after="12pt">
        Document with Headers and Footers
      </fo:block>

      <fo:block space-after="12pt">
        This document demonstrates headers and footers using region-before and region-after.
        The header appears at the top of every page, and the footer appears at the bottom
        with automatic page numbering.
      </fo:block>
    </fo:flow>
  </fo:page-sequence>
</fo:root>
